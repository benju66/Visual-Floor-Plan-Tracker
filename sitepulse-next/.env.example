# SitePulse frontend (Next.js) — copy to `.env.local` and fill in.
# `.env.local` is gitignored; this template is committed (see `!.env.example` in .gitignore).
# NEXT_PUBLIC_* values are inlined into the browser bundle; the rest are server-only.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Your Supabase project URL and its public "anon" key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-SIDE ONLY (used by the Next.js API routes, never the
# browser). Without it, creating a project from the dashboard fails. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Backend API (required) ────────────────────────────────────────────────────
# The FastAPI backend base URL. For local dev the backend runs on port 8001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# ── Procore SSO (optional — leave blank for non-SSO local dev) ─────────────────
# Procore App Marketplace OAuth credentials + the domain allow-list for auto-
# provisioned users. PROCORE_ALLOWED_EMAIL_DOMAINS is comma-separated and
# FAIL-CLOSED: if it is unset, SSO sign-in is refused (a safe default).
NEXT_PUBLIC_PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_ALLOWED_EMAIL_DOMAINS=
