# SitePulse backend (FastAPI) — copy to `.env` and fill in.
# `.env` is gitignored; this template is committed.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Your Supabase project URL and a service key (Project Settings → API). The
# backend uses this key for storage + table writes on the server side.
SUPABASE_URL=
SUPABASE_KEY=

# Legacy — read at startup only. JWT verification is JWKS/ES256 (the project's
# public signing key), NOT this value, so it is not used to verify tokens. Kept
# for the startup check; safe to leave as any non-empty placeholder locally.
SUPABASE_JWT_SECRET=

# ── CORS (optional — the code default matches local dev) ──────────────────────
# The frontend origin allowed by CORS. Defaults to http://localhost:3010 (the
# local dev port), so you only need to set this if the frontend runs elsewhere.
FRONTEND_URL=http://localhost:3010

# ── Upload / extraction limits (optional — sensible defaults baked in) ────────
# Max upload size in MB (default 80) and the hard cap on extracted snapping-
# vector segments (default 40000) that keeps the sheet_vectors write inside the
# database statement timeout. Leave unset to use the defaults.
MAX_UPLOAD_MB=80
VECTOR_CAP_LINES=40000
